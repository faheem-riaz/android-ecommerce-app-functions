                                        "text": "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\" xmlns:appfn=\"http://schemas.android.com/apk/androidx.appfunctions\">\n <application android:name=\".ShopApplication\" android:label=\"Feemag Shop\" android:icon=\"@drawable/ic_shop\" android:theme=\"@style/Theme.Shop\" android:allowBackup=\"false\" android:supportsRtl=\"true\" appfn:description=\"@string/app_description\" appfn:displayDescription=\"@string/app_description\">\n  <activity android:name=\".MainActivity\" android:exported=\"true\">\n   <intent-filter><action android:name=\"android.intent.action.MAIN\"/><category android:name=\"android.intent.category.LAUNCHER\"/></intent-filter>\n"
